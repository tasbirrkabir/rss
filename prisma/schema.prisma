generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Booking request pipeline (PRD section 28):
// NEW -> CONTACTED -> CONFIRMED -> COMPLETED -> CANCELLED
model BookingRequest {
  id               String   @id @default(cuid())
  rideDate         String // ISO date (yyyy-mm-dd) — stored as string: demo scope, timezone-safe
  duration         String // HALF_DAY | FULL_DAY
  vehicleId        String? // mini-scooty | standard-scooty | null = no preference
  name             String
  phone            String
  pickupPreference String? // shop | hotel | unsure
  message          String?
  status           String   @default("NEW")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
